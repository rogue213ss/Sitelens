# --- Backend (used when running the API directly, without Docker) ---
# Defaults to a local SQLite file. Point this at PostgreSQL instead when
# using docker-compose, or any real Postgres instance:
#   postgresql+psycopg://sitelens:sitelens@localhost:5432/sitelens
DATABASE_URL=sqlite:///./sitelens.db
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Postgres (used by docker-compose's `db` service) ---
POSTGRES_USER=sitelens
POSTGRES_PASSWORD=sitelens
POSTGRES_DB=sitelens
